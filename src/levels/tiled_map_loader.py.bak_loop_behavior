import json
from pathlib import Path

import pygame


class MovingPlatform:
    HORIZONTAL_TYPES = {"horizontal", "left_right", "leftright", "x", "patrol_x"}
    VERTICAL_TYPES = {"vertical", "up_down", "updown", "y", "patrol_y"}
    ONE_WAY_TYPES = {"elevator_down", "elevator_up", "one_way_down", "one_way_up", "one_way"}

    def __init__(
        self,
        rect,
        name="",
        move_type="vertical",
        speed=100,
        end_x=None,
        end_y=None,
        distance=None,
        auto_start=False,
        reverse_on_collision=True,
        start_direction=None,
    ):
        self.rect = rect
        self.name = name
        self.move_type = str(move_type or "vertical").strip().lower()
        self.speed = float(speed)
        self.start_x = rect.x
        self.start_y = rect.y
        self.current_x = float(rect.x)
        self.current_y = float(rect.y)
        self.auto_start = bool(auto_start)
        self.reverse_on_collision = bool(reverse_on_collision)
        self.active = not self.auto_start
        self.arrived = False

        self.one_way = self.move_type in self.ONE_WAY_TYPES
        self.axis = "x" if self.move_type in self.HORIZONTAL_TYPES else "y"
        if self.move_type in ("elevator_up", "one_way_up", "one_way_down", "elevator_down"):
            self.axis = "y"

        distance_given = distance not in (None, "")
        end_x_given = end_x not in (None, "")
        end_y_given = end_y not in (None, "")
        axis_end_given = end_x_given if self.axis == "x" else end_y_given
        self.unbounded = not self.one_way and not distance_given and not axis_end_given

        if distance_given:
            distance = float(distance)
        else:
            # Only one-way elevators get a default travel amount. Normal platforms
            # without distance/end values patrol until they hit collision.
            distance = 160 if self.one_way and self.axis == "x" else 120

        self.end_x = self._coerce(end_x, self.start_x + distance if self.axis == "x" else self.start_x)
        self.end_y = self._coerce(end_y, self.start_y + distance if self.axis == "y" else self.start_y)

        if self.move_type in ("elevator_down", "one_way_down"):
            self.end_y = max(self.end_y, self.start_y + abs(distance))
        elif self.move_type in ("elevator_up", "one_way_up"):
            self.end_y = min(self.end_y, self.start_y - abs(distance))

        if start_direction is None:
            target = self.end_x if self.axis == "x" else self.end_y
            start = self.start_x if self.axis == "x" else self.start_y
            self.direction = 1 if self.unbounded or target >= start else -1
        else:
            self.direction = self._direction_value(start_direction)

    def _coerce(self, value, default):
        try:
            return float(value)
        except (TypeError, ValueError):
            return float(default)

    def _direction_value(self, value):
        text = str(value).strip().lower()
        if text in ("left", "up", "-1", "negative", "backward"):
            return -1
        if text in ("right", "down", "1", "+1", "positive", "forward"):
            return 1
        try:
            return 1 if float(value) >= 0 else -1
        except (TypeError, ValueError):
            return 1

    def reset(self):
        self.rect.x = self.start_x
        self.rect.y = self.start_y
        self.current_x = float(self.start_x)
        self.current_y = float(self.start_y)
        self.active = not self.auto_start
        self.arrived = False
        target = self.end_x if self.axis == "x" else self.end_y
        start = self.start_x if self.axis == "x" else self.start_y
        self.direction = 1 if self.unbounded or target >= start else -1

    def player_is_on_top(self, player):
        horizontal_overlap = (
            player.rect.right > self.rect.left + 4
            and player.rect.left < self.rect.right - 4
        )
        vertical_contact = abs(player.rect.bottom - self.rect.top) <= 8
        return horizontal_overlap and vertical_contact and player.vel_y >= 0

    def update(self, dt, player, solid_rects=None):
        if self.arrived or self.speed <= 0:
            return

        solid_rects = solid_rects or []
        player_on_platform = self.player_is_on_top(player)

        if self.auto_start and player_on_platform:
            self.active = True

        if not self.active:
            return

        old_x = self.rect.x
        old_y = self.rect.y

        if self.one_way:
            self._update_one_way(dt, solid_rects)
        else:
            self._update_ping_pong(dt, solid_rects)

        delta_x = self.rect.x - old_x
        delta_y = self.rect.y - old_y

        if player_on_platform and (delta_x != 0 or delta_y != 0):
            player.rect.x += delta_x
            player.rect.y += delta_y
            player.vel_y = 0
            player.on_ground = True

    def _update_one_way(self, dt, solid_rects):
        target = self.end_x if self.axis == "x" else self.end_y
        current = self.current_x if self.axis == "x" else self.current_y
        direction = 1 if target >= current else -1
        next_value = current + direction * self.speed * dt

        if direction > 0:
            next_value = min(target, next_value)
        else:
            next_value = max(target, next_value)

        if self._try_set_axis(next_value, solid_rects):
            if next_value == target:
                self.arrived = True
        else:
            self.arrived = True

    def _update_ping_pong(self, dt, solid_rects):
        if self.unbounded:
            current = self.current_x if self.axis == "x" else self.current_y
            next_value = current + self.direction * self.speed * dt
            if not self._try_set_axis(next_value, solid_rects) and self.reverse_on_collision:
                self.direction *= -1
            return

        start = self.start_x if self.axis == "x" else self.start_y
        end = self.end_x if self.axis == "x" else self.end_y
        low = min(start, end)
        high = max(start, end)
        current = self.current_x if self.axis == "x" else self.current_y

        next_value = current + self.direction * self.speed * dt
        hit_endpoint = False

        if next_value > high:
            next_value = high
            hit_endpoint = True
        elif next_value < low:
            next_value = low
            hit_endpoint = True

        if self._try_set_axis(next_value, solid_rects):
            if hit_endpoint:
                self.direction *= -1
        elif self.reverse_on_collision:
            self.direction *= -1

    def _try_set_axis(self, next_value, solid_rects):
        next_x = self.current_x
        next_y = self.current_y
        if self.axis == "x":
            next_x = next_value
        else:
            next_y = next_value

        test_rect = self.rect.copy()
        test_rect.x = int(round(next_x))
        test_rect.y = int(round(next_y))

        if self.reverse_on_collision:
            for solid in solid_rects:
                if solid is self.rect:
                    continue
                if test_rect.colliderect(solid):
                    return False

        self.current_x = next_x
        self.current_y = next_y
        self.rect.x = test_rect.x
        self.rect.y = test_rect.y
        return True


def load_tiled_map(path):
    path = Path(path)
    if not path.exists():
        return None

    with path.open("r", encoding="utf-8") as file:
        data = json.load(file)

    width = int(data.get("width", 0)) * int(data.get("tilewidth", 1))
    height = int(data.get("height", 0)) * int(data.get("tileheight", 1))

    layers = {layer.get("name", "").lower(): layer for layer in data.get("layers", [])}

    collision_platforms = _load_rect_layer(layers, "collision")
    platforms = list(collision_platforms)
    moving_platforms = _load_moving_platforms(layers)
    platforms.extend(platform.rect for platform in moving_platforms)

    spawns = _load_spawns(layers)
    doors = _load_doors(layers)
    fulcrums = _load_fulcrums(layers)
    checkpoints = _load_named_rects(layers, "checkpoints")
    interactables = _load_named_rects(layers, "interactables")
    hazards = _load_named_rects(layers, "hazards")

    shop_rect = None
    for item in interactables:
        item_type = str(item.get("type") or item.get("name") or "").lower()
        if item_type == "merchant":
            shop_rect = item["rect"]
            break

    return {
        "width": width,
        "height": height,
        "platforms": platforms,
        "collision_platforms": collision_platforms,
        "moving_platforms": moving_platforms,
        "player_spawn": spawns.get("player_spawn"),
        "enemy_spawns": spawns.get("enemy_spawns", []),
        "boss_spawn": spawns.get("boss_spawn"),
        "doors": doors,
        "fulcrums": fulcrums,
        "checkpoints": checkpoints,
        "interactables": interactables,
        "hazards": hazards,
        "shop_rect": shop_rect,
    }


def _layer_objects(layers, layer_name):
    layer = layers.get(layer_name.lower())
    if not layer:
        return []
    return layer.get("objects", []) or []


def _properties(obj):
    props = {}
    for prop in obj.get("properties", []) or []:
        props[prop.get("name")] = prop.get("value")
    return props


def _rect(obj):
    return pygame.Rect(
        int(round(float(obj.get("x", 0)))),
        int(round(float(obj.get("y", 0)))),
        int(round(float(obj.get("width", 0)))),
        int(round(float(obj.get("height", 0)))),
    )


def _spawn_point(obj):
    rect = _rect(obj)
    if rect.width == 0 and rect.height == 0:
        return (rect.x, rect.y)
    return rect.midbottom


def _load_rect_layer(layers, layer_name):
    rects = []
    for obj in _layer_objects(layers, layer_name):
        rect = _rect(obj)
        if rect.width > 0 and rect.height > 0:
            rects.append(rect)
    return rects


def _load_moving_platforms(layers):
    moving_platforms = []
    objects = []
    objects.extend(_layer_objects(layers, "movingplatforms"))
    objects.extend(_layer_objects(layers, "moving"))

    for obj in objects:
        rect = _rect(obj)
        if rect.width <= 0 or rect.height <= 0:
            continue

        props = _properties(obj)
        obj_name = str(obj.get("name") or "")
        move_type = props.get("move_type") or props.get("movement") or props.get("direction") or obj.get("type")
        if not move_type:
            move_type = _move_type_from_name(obj_name)

        moving_platforms.append(
            MovingPlatform(
                rect,
                name=obj_name,
                move_type=str(move_type or "vertical"),
                speed=_float(props.get("speed"), 100),
                end_x=props.get("end_x"),
                end_y=props.get("end_y"),
                distance=props.get("distance"),
                auto_start=_bool(props.get("auto_start"), False),
                reverse_on_collision=_bool(props.get("reverse_on_collision"), True),
                start_direction=props.get("start_direction"),
            )
        )
    return moving_platforms


def _move_type_from_name(name):
    lowered = str(name or "").strip().lower().replace("-", "_").replace(" ", "_")
    if any(token in lowered for token in ("horizontal", "left_right", "leftright", "patrol_x")):
        return "horizontal"
    if any(token in lowered for token in ("vertical", "up_down", "updown", "patrol_y")):
        return "vertical"
    if "elevator_down" in lowered or lowered.endswith("_down"):
        return "elevator_down"
    if "elevator_up" in lowered or lowered.endswith("_up"):
        return "elevator_up"
    return "vertical"


def _load_spawns(layers):
    result = {"enemy_spawns": []}
    objects = list(_layer_objects(layers, "spawns"))

    # Friendly layer aliases:
    # - Spawns is the preferred layer name.
    # - Player is accepted because MAP 4 currently uses it.
    # - player_guide keeps older MAP 2 exports working.
    if not objects:
        objects.extend(_layer_objects(layers, "player"))
    if not objects:
        objects.extend(_layer_objects(layers, "player_guide"))

    for obj in objects:
        props = _properties(obj)
        name = str(obj.get("name") or props.get("name") or "").lower()
        point = _spawn_point(obj)

        if name in ("player_spawn", "spawn", "spawns", "kael_spawn", "start"):
            result["player_spawn"] = point
        elif name == "boss_spawn":
            result["boss_spawn"] = point
        elif name.startswith("enemy"):
            result["enemy_spawns"].append(point)

    return result


def _load_doors(layers):
    doors = []
    for obj in _layer_objects(layers, "doors"):
        rect = _rect(obj)
        if rect.width <= 0 or rect.height <= 0:
            continue

        props = _properties(obj)
        doors.append(
            {
                "rect": rect,
                "target_map": props.get("target_map", props.get("target", 2)),
                "label": str(props.get("label") or obj.get("name") or "Level 2"),
                "visible": _bool(props.get("visible"), True),
                "auto": _bool(props.get("auto"), False),
            }
        )
    return doors


def _load_fulcrums(layers):
    fulcrums = []
    for obj in _layer_objects(layers, "fulcrums"):
        rect = _rect(obj)
        if rect.width <= 0 or rect.height <= 0:
            continue

        props = _properties(obj)
        anchor = (
            int(round(_float(props.get("anchor_x"), rect.centerx))),
            int(round(_float(props.get("anchor_y"), rect.centery))),
        )
        target = (
            int(round(_float(props.get("target_x"), anchor[0]))),
            int(round(_float(props.get("target_y"), anchor[1]))),
        )

        fulcrums.append(
            {
                "rect": rect,
                "anchor": anchor,
                "target": target,
                "used": False,
                "name": obj.get("name", ""),
                "interact_distance": _float(props.get("interact_distance"), 180),
                "requires_grapple_weapon": _bool(props.get("requires_grapple_weapon"), False),
            }
        )
    return fulcrums


def _load_named_rects(layers, layer_name):
    items = []
    for obj in _layer_objects(layers, layer_name):
        rect = _rect(obj)
        if rect.width <= 0 or rect.height <= 0:
            continue

        props = _properties(obj)
        item = {
            "rect": rect,
            "name": obj.get("name", ""),
            "type": obj.get("type", ""),
        }
        item.update(props)
        items.append(item)
    return items


def _float(value, default):
    try:
        return float(value)
    except (TypeError, ValueError):
        return float(default)


def _bool(value, default):
    if isinstance(value, bool):
        return value
    if value is None:
        return default
    return str(value).strip().lower() in ("1", "true", "yes", "on")
